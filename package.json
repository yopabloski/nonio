{
  "name": "nonio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nonio · plataforma de cuestionarios psicoeducativos · ICI UDD. Primer estudio: AMA·PERMA (EME-E, IPAA, EAPESA, PERMA-Profiler)",
  "scripts": {
    "serve": "python3 -m http.server 5173",
